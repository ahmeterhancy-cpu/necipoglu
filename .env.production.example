# Cahit Necipoğlu — canlı sunucu ayarları.
# Sunucuda public_html/necipoglu_app/.env adıyla oluşturup doldurun.
# .env asla git'e girmez (bkz. .gitignore) — deploy da üzerine yazmaz.
# cPanel hesabı: neci2913

APP_NAME="Cahit Necipoğlu"
APP_ENV=production
# Boş bırakın: ilk deploy anahtarı kendisi üretip buraya yazar (.cpanel.yml).
# Üretildikten sonra DEĞİŞTİRMEYİN — oturumlar ve PIN çerezleri ona bağlı.
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.necipoglu.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

# KKTC saati. Europe/Istanbul ya da Europe/Nicosia KULLANMAYIN.
APP_TIMEZONE=Asia/Famagusta

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# cPanel → MySQL Veritabanları'nda oluşturduğunuz bilgiler
DB_CONNECTION=mysql
# 127.0.0.1 DEĞİL: cPanel yetkiyi 'kullanici'@'localhost' olarak verir;
# 127.0.0.1 TCP ile bağlanır ve parola doğru olsa bile reddedilir.
DB_HOST=localhost
DB_PORT=3306
# cPanel veritabanı ve kullanıcı adını 16 karakterde keser.
DB_DATABASE=neci2913_necipog
DB_USERNAME=neci2913_necipog
DB_PASSWORD=

# Panelden yüklenen görseller doğrudan web'in gördüğü klasöre yazılır
# (web kökündeki storage sembolik bağı bu sunucularda takip edilmiyor).
FILESYSTEM_PUBLIC_ROOT=/home/neci2913/public_html/storage

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Katalog modu: sepet/ödeme/üyelik kapalı, ürünlerde "İncele" + "Bilgi al".
SHOP_CATALOG=true

# İlk deploy'da `admin:olustur` bu bilgilerle yönetici hesabını açar
# (hesap varsa dokunmaz). Parola en az 10 karakter.
# Panele girdikten sonra ADMIN_PASSWORD satırını SİLİN.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Yönetici"

# İlk kurulumda yapım aşaması sayfası AÇIK gelir; bu PIN'i giren cihaz siteyi
# görür. Boş bırakılırsa PIN sonradan panelden (Site Ayarları) verilir.
CONSTRUCTION_PIN=

# cPanel → E-posta Hesapları'nda açılan kutu (şimdilik kapalı: log)
MAIL_MAILER=log
MAIL_HOST=mail.necipoglu.com
MAIL_PORT=465
MAIL_USERNAME=info@necipoglu.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@necipoglu.com"
MAIL_FROM_NAME="${APP_NAME}"
